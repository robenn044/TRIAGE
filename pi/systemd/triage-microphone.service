[Unit]
Description=TRIAGE Face Pi Microphone Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/TRIAGE/pi/face
ExecStart=/home/admin/TRIAGE/pi/face/venv/bin/python microphone.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
