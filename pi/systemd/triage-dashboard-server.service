[Unit]
Description=TRIAGE Local Dashboard Server (Brain Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/TRIAGE/pi/brain
ExecStart=/usr/bin/python3 serve_dashboard.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
