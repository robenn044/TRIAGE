[Unit]
Description=TRIAGE Face Pi Camera Stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=triageface
WorkingDirectory=/home/triageface/TRIAGE/pi/face
ExecStart=/home/triageface/TRIAGE/pi/face/venv/bin/python camera.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
